# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Local data / secrets
backend/data/*.db
backend/data/*.db-journal
backend/data/uploads/*
!backend/data/uploads/.gitkeep
.env
.env.local
*.pem

# Large datasets (keep only tiny samples in git)
datasets/generated/*
!datasets/generated/.gitkeep
benchmarks/raw/*
!benchmarks/raw/.gitkeep
benchmarks/processed/*
!benchmarks/processed/.gitkeep
benchmarks/results/*
!benchmarks/results/.gitkeep
!benchmarks/results/*_summary.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Office lock files / local binaries
~$*
native/openmp_worker/*.dll
native/openmp_worker/analysis-report.txt

# Coverage / local logs (keep committed sample)
.coverage
htmlcov/
*.log
!data/samples/synth_small.log
